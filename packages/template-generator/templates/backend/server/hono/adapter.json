{
  "id": "hono",
  "name": "Hono",
  "description": "Ultrafast web framework",
  "icon": "/icons/hono.svg",
  "apps": {
    "backend": {
      "legacy": true,
      "options": {
        "runtime": { "values": ["bun", "node", "workers"], "visibility": "visible" },
        "api": { "values": ["trpc", "orpc", "none"], "visibility": "advanced" }
      },
      "devArgs": [],
      "serverContributions": { "apiPrefix": "" },
      "productContribution": {
        "mode": "server",
        "protocol": "product-http-v1",
        "modules": [
          "core",
          "i18n",
          "auth",
          "admin",
          "email",
          "sms",
          "captcha",
          "payment",
          "credits",
          "affiliate",
          "storage",
          "ai",
          "blog",
          "seo"
        ],
        "constraints": {
          "runtime": ["bun", "node"],
          "api": ["none"],
          "orm": ["drizzle"],
          "database": ["sqlite", "postgres"],
          "webDeploy": ["none"]
        },
        "frameworks": [
          {
            "id": "http-server",
            "modules": [
              "core",
              "auth",
              "admin",
              "captcha",
              "payment",
              "credits",
              "affiliate",
              "storage",
              "ai",
              "blog",
              "seo"
            ]
          }
        ]
      },
      "stack": {
        "backend": "hono",
        "runtime": "bun",
        "api": "orpc"
      }
    }
  }
}
