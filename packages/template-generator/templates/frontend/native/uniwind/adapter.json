{
  "id": "native-uniwind",
  "name": "Expo + Uniwind",
  "description": "Fastest Tailwind bindings for React Native with HeroUI Native",
  "icon": "/icons/expo.svg",
  "apps": {
    "native": {
      "legacy": true,
      "options": {
        "runtime": { "values": ["none"], "visibility": "hidden" },
        "api": { "values": ["none"], "visibility": "hidden" }
      },
      "acceptsBackendApis": ["trpc", "orpc", "none"],
      "clientContributions": { "framework": "uniwind", "family": "native" },
      "stack": {
        "frontend": ["native-uniwind"],
        "runtime": "none",
        "api": "none"
      }
    }
  }
}
