        "constraints": {
          "runtime": ["bun", "node"],
          "api": ["none"],
          "orm": ["drizzle"],
          "database": ["sqlite", "postgres"],
          "webDeploy": ["none"]
        },
        "frameworks": [{ "id": "react-router", "modules": ["core"] }],
        "client": {
          "framework": "react-router",
          "modules": ["core", "i18n", "auth", "admin", "captcha"],
          "integrations": ["email", "sms"]
        }
      },
      "stack": {
        "frontend": ["react-router"],
        "runtime": "none",
        "api": "none"
      }
    }
  }
}
