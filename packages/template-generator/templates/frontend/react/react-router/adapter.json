{
  "id": "react-router",
  "name": "React Router",
  "description": "Declarative routing for React",
  "icon": "/icons/react-router.svg",
  "apps": {
    "web-frontend": {
      "legacy": true,
      "options": {
        "runtime": { "values": ["none"], "visibility": "hidden" },
        "api": { "values": ["none"], "visibility": "hidden" }
      },
      "acceptsBackendApis": ["trpc", "orpc", "none"],
      "clientContributions": { "framework": "react-router", "family": "react", "serverAuth": true },
      "devArgs": ["--host", "127.0.0.1"],
      "sharedPackages": ["ui"],
      "productContribution": {
        "mode": "client",
        "protocol": "product-http-v1",
        "modules": [
          "core",
          "i18n",
          "auth",
          "admin",
          "email",
          "sms",
          "captcha",
          "payment",
          "credits",
          "affiliate",
          "storage",
          "ai",
          "blog",
          "seo"
        ],
        "constraints": {
          "runtime": ["bun", "node"],
          "api": ["none"],
          "orm": ["drizzle"],
          "database": ["sqlite", "postgres"],
          "webDeploy": ["none"]
        },
        "frameworks": [{ "id": "react-router", "modules": ["core"] }],
        "client": {
          "framework": "react-router",
          "modules": [
            "core",
            "i18n",
            "auth",
            "admin",
            "captcha",
            "payment",
            "credits",
            "affiliate",
            "storage",
            "ai",
            "blog",
            "seo"
          ],
          "integrations": ["email", "sms", "admin", "payment", "seo"]
        }
      },
      "stack": {
        "frontend": ["react-router"],
        "runtime": "none",
        "api": "none"
      }
    },
    "admin": {
