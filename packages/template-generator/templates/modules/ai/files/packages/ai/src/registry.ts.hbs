};
export function providers(env: AIEnv): AIProvider[] {
  const selected: (AIProvider | undefined)[] = [
{{#if (includes module.providers "openai")}}
    openai(env),
{{/if}}
{{#if (includes module.providers "google")}}
    google(env),
{{/if}}
{{#if (includes module.providers "openai-compatible")}}
    compatible(env),
{{/if}}
  ];
