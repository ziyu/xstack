{{#if (includes module.providers "wechat")}}
import { createHash } from "node:crypto";
{{/if}}
import { drizzleAdapter } from "@better-auth/drizzle-adapter/relations-v2";
import type { Database } from "@{{projectName}}/db";
import * as schema from "@{{projectName}}/db/schema/auth";
import type { EventBus } from "@{{projectName}}/events";
{{#if (includes module.integrations "email")}}
import { localeFromHeaders } from "@{{projectName}}/i18n";
{{/if}}
import { betterAuth } from "better-auth";
import { nextCookies } from "better-auth/next-js";
import { admin } from "better-auth/plugins";

import "./events";
{{#if (includes module.integrations "sms")}}
import { createPhoneAuth } from "./phone";
{{/if}}

export type AuthConfig = {
  BETTER_AUTH_URL: string;
  BETTER_AUTH_SECRET: string;
  ADMIN_EMAILS?: string;
{{#if (includes module.providers "google")}}
  GOOGLE_CLIENT_ID?: string;
  GOOGLE_CLIENT_SECRET?: string;
{{/if}}
{{#if (includes module.providers "github")}}
  GITHUB_CLIENT_ID?: string;
  GITHUB_CLIENT_SECRET?: string;
{{/if}}
{{#if (includes module.providers "wechat")}}
  WECHAT_CLIENT_ID?: string;
  WECHAT_CLIENT_SECRET?: string;
{{/if}}
};

export const roles = ["user", "admin"] as const;

export type Role = (typeof roles)[number];

function parseEmails(value: string | undefined): Set<string> {
  return new Set(
    (value ?? "")
      .split(",")
      .map((email) => email.trim().toLowerCase())
      .filter(Boolean),
  );
}

export function createAuth(env: AuthConfig, database: Database, events: EventBus) {
  const adminEmails = parseEmails(env.ADMIN_EMAILS);

  return betterAuth({
    database: drizzleAdapter(database, {
      provider: "{{#if (eq database "postgres")}}pg{{else}}sqlite{{/if}}",
      schema,
    }),
    secret: env.BETTER_AUTH_SECRET,
    baseURL: env.BETTER_AUTH_URL,
    trustedOrigins: [env.BETTER_AUTH_URL],
{{#if (includes module.integrations "sms")}}
    rateLimit: {
      enabled: true,
      storage: "database",
      customRules: {
        "/phone-number/send-otp": { window: 60, max: 5 },
        "/phone-number/verify": { window: 60, max: 10 },
      },
    },
{{/if}}
    emailAndPassword: {
      enabled: true,
{{#if (includes module.integrations "email")}}
      requireEmailVerification: true,
      revokeSessionsOnPasswordReset: true,
      sendResetPassword: async ({ user, url }, request) => {
        await events.emit("auth.password_reset_requested", {
          email: user.email,
          name: user.name,
          url,
          locale: localeFromHeaders(request?.headers),
        });
      },
{{/if}}
    },
{{#if (includes module.integrations "email")}}
    emailVerification: {
      sendOnSignUp: true,
      autoSignInAfterVerification: true,
      sendVerificationEmail: async ({ user, url }, request) => {
        await events.emit("auth.verification_requested", {
          email: user.email,
          name: user.name,
          url,
          locale: localeFromHeaders(request?.headers),
        });
      },
    },
{{/if}}
    socialProviders: {
{{#if (includes module.providers "google")}}
      ...(env.GOOGLE_CLIENT_ID && env.GOOGLE_CLIENT_SECRET
        ? { google: { clientId: env.GOOGLE_CLIENT_ID, clientSecret: env.GOOGLE_CLIENT_SECRET } }
        : {}),
{{/if}}
{{#if (includes module.providers "github")}}
      ...(env.GITHUB_CLIENT_ID && env.GITHUB_CLIENT_SECRET
        ? { github: { clientId: env.GITHUB_CLIENT_ID, clientSecret: env.GITHUB_CLIENT_SECRET } }
        : {}),
{{/if}}
{{#if (includes module.providers "wechat")}}
      ...(env.WECHAT_CLIENT_ID?.trim() && env.WECHAT_CLIENT_SECRET?.trim()
        ? {
            wechat: {
              clientId: env.WECHAT_CLIENT_ID.trim(),
              clientSecret: env.WECHAT_CLIENT_SECRET.trim(),
              lang: "cn" as const,
              disableIdTokenSignIn: true,
              // WeChat does not provide a verified email. Never trust a profile email
              // or use it to link to an existing email/password account.
              mapProfileToUser: (profile: { openid: string; unionid?: string }) => ({
                email: `wechat-${createHash("sha256").update(`${env.WECHAT_CLIENT_ID!.trim()}:${profile.unionid || profile.openid}`).digest("hex").slice(0, 48)}@wechat.invalid`,
                emailVerified: false,
              }),
            },
          }
        : {}),
{{/if}}
    },
    databaseHooks: {
{{#if (includes module.integrations "sms")}}
      verification: {
        create: {
          // The phone plugin writes an unused plaintext OTP before sendOTP.
          // Suppress only this flow; email/reset verification stays untouched.
          before: async (verification, context) => {
            if (
              context?.path === "/phone-number/send-otp" &&
              verification.identifier === context.body?.phoneNumber &&
              /^\+[1-9]\d{7,14}$/.test(verification.identifier)
            ) return false;
          },
        },
      },
{{/if}}
      user: {
        create: {
          before: async (user) => ({
            data: { ...user, role: {{#if (includes module.integrations "sms")}}!user.email.toLowerCase().endsWith("@phone.invalid") && {{/if}}{{#if (includes module.providers "wechat")}}!user.email.toLowerCase().endsWith("@wechat.invalid") && {{/if}}adminEmails.has(user.email.toLowerCase()) ? "admin" : "user" },
          }),
          after: async (user) => {
            await events.emit("auth.user_created", {
              userId: user.id,
              email: user.email,
              name: user.name,
            });
          },
        },
      },
    },
    plugins: [admin({ defaultRole: "user", adminRoles: ["admin"] }), {{#if (includes module.integrations "sms")}}createPhoneAuth(env.BETTER_AUTH_SECRET, database, events), {{/if}}nextCookies()],
  });
}

export type Auth = ReturnType<typeof createAuth>;

export type Session = Auth["$Infer"]["Session"];
