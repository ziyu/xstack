{
  "id": "payment",
  "name": {
    "en": "Payments",
    "zh-CN": "支付"
  },
  "description": {
    "en": "Pricing page, one-time payments and subscriptions with provider webhooks",
    "zh-CN": "定价页、一次性支付与订阅，处理服务商 webhook"
  },
  "category": "monetization",
  "requires": ["auth"],
  "enhances": ["admin"],
  "supports": {
    "frameworks": ["next", "tanstack-start", "nuxt"],
    "backends": ["self"],
    "apis": ["none"],
    "orms": ["drizzle"],
    "dialects": ["sqlite", "postgres"]
  },
  "nativeSplit": true,
  "providers": {
    "min": 1,
    "default": {
      "global": ["stripe"],
      "cn": ["wechat", "alipay"]
    },
    "options": {
      "wechat": {
        "name": "WeChat Pay",
        "market": "cn",
        "dependencies": {
          "zod": "$dependency:zod"
        },
        "appDependencies": {
          "qrcode": "^1.5.4",
          "@types/qrcode": "^1.5.5"
        },
        "env": [
          {
            "key": "WECHAT_PAY_APP_ID",
            "required": false,
            "sensitive": false
          },
          {
            "key": "WECHAT_PAY_MCH_ID",
            "required": false,
            "sensitive": false
          },
          {
            "key": "WECHAT_PAY_SERIAL_NO",
            "required": false,
            "sensitive": false
          },
          {
            "key": "WECHAT_PAY_PRIVATE_KEY",
            "required": false
          },
          {
            "key": "WECHAT_PAY_API_V3_KEY",
            "required": false
          },
          {
            "key": "WECHAT_PAY_PUBLIC_KEY_ID",
            "required": false,
            "sensitive": false
          },
          {
            "key": "WECHAT_PAY_PUBLIC_KEY",
            "required": false
          }
        ]
      },
      "alipay": {
        "name": "Alipay",
        "market": "cn",
        "supports": {
          "targets": ["none", "node", "vercel", "docker"]
        },
        "dependencies": {
          "alipay-sdk": "^4.14.0"
        },
        "env": [
          {
            "key": "ALIPAY_APP_ID",
            "required": false,
            "sensitive": false
          },
          {
            "key": "ALIPAY_PRIVATE_KEY",
            "required": false
          },
          {
            "key": "ALIPAY_PUBLIC_KEY",
            "required": false
          },
          {
            "key": "ALIPAY_SELLER_ID",
            "required": false,
            "sensitive": false
          },
          {
            "key": "ALIPAY_SANDBOX",
            "required": false,
            "sensitive": false,
            "type": "boolean",
            "default": "false"
          }
        ]
      },
      "stripe": {
        "name": "Stripe",
        "market": "global",
        "dependencies": {
          "stripe": "^23.0.0"
        },
        "env": [
          {
            "key": "STRIPE_SECRET_KEY",
            "required": false
          },
          {
            "key": "STRIPE_WEBHOOK_SECRET",
            "required": false
          }
        ]
      },
      "mock": {
        "name": "Mock (development only)",
        "market": "any"
      },
      "polar": {
        "name": "Polar",
        "market": "global",
        "dependencies": {
          "@polar-sh/sdk": "^1.0.2"
        },
        "env": [
          {
            "key": "POLAR_ACCESS_TOKEN",
            "required": false
          },
          {
            "key": "POLAR_WEBHOOK_SECRET",
            "required": false
          },
          {
            "key": "POLAR_SERVER",
            "required": false,
            "sensitive": false,
            "type": "enum",
            "values": ["sandbox", "production"],
            "default": "sandbox"
          }
        ]
      }
    }
  },
  "packages": [
    {
      "dir": "payment",
      "dependencies": {
        "drizzle-orm": "$dependency:drizzle-orm"
      },
      "workspaceDependencies": ["db", "events"]
    }
  ],
  "services": [
    {
      "name": "payment",
      "imports": [
        {
          "from": "@app/payment",
          "names": ["createPayment"]
        }
      ],
      "init": "createPayment({ env: ENV, db, events, baseUrl: ENV.BETTER_AUTH_URL, clientOrigins: {{{clientOrigins}}} })"
    }
  ],
  "nav": [
    {
      "area": "main",
      "href": "/pricing",
      "labelKey": "nav.pricing",
      "order": 20
    },
    {
      "area": "dashboard",
      "href": "/dashboard/billing",
      "labelKey": "nav.billing",
      "order": 50
    },
    {
      "area": "admin",
      "href": "/admin/orders",
      "labelKey": "nav.orders",
      "order": 20,
      "when": "admin"
    }
  ],
  "notices": [
    "Mock payments are development-only. Production payments require a real provider, its credentials, webhook configuration and product/price setup. Polar defaults to sandbox; switch its environment to production before launch."
  ],
  "sources": {
    "dialects": true,
    "frameworks": ["http-server", "next", "nuxt", "tanstack-start"],
    "providers": {
      "mode": "separate",
      "frameworks": {
        "mock": {
          "next": "providers/mock/frameworks/next"
        }
      }
    },
    "integrations": {
      "admin": {
        "frameworks": {
          "next": "integrations/admin/frameworks/next",
          "tanstack-start": "integrations/admin/frameworks/tanstack-start",
          "nuxt": "frameworks/nuxt"
        }
      }
    },
    "frameworkRequired": {
      "http-server": ["shared/partials/payment.hbs"]
    }
  }
}
