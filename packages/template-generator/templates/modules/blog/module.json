{
  "id": "blog",
  "name": {
    "en": "Blog",
    "zh-CN": "博客"
  },
  "description": {
    "en": "Database-backed multilingual publishing with admin authoring and safe Markdown",
    "zh-CN": "数据库驱动的多语言发布、后台编辑与安全 Markdown"
  },
  "category": "content",
  "requires": ["admin"],
  "enhances": ["seo"],
  "supports": {
    "frameworks": ["next", "tanstack-start", "nuxt"],
    "backends": ["self"],
    "apis": ["none"],
    "orms": ["drizzle"],
    "dialects": ["sqlite", "postgres"]
  },
  "packages": [
    {
      "dir": "blog",
      "dependencies": {
        "drizzle-orm": "$dependency:drizzle-orm",
        "zod": "$dependency:zod"
      },
      "workspaceDependencies": ["db", "i18n", "permissions"]
    }
  ],
  "frameworkAppDependencies": {
    "next": {
      "react-markdown": "^10.1.0"
    },
    "tanstack-start": {
      "react-markdown": "^10.1.0"
    },
    "nuxt": {
      "markdown-it": "^14.1.0",
      "@types/markdown-it": "^14.1.2"
    }
  },
  "services": [
    {
      "name": "blog",
      "imports": [
        {
          "from": "@app/blog",
          "names": ["createBlog"]
        }
      ],
      "init": "createBlog(db)"
    }
  ],
  "nav": [
    {
      "area": "main",
      "href": "/blog",
      "labelKey": "nav.blog",
      "order": 30
    },
    {
      "area": "admin",
      "href": "/admin/blog",
      "labelKey": "nav.blog",
      "order": 40
    }
  ],
  "sources": {
    "dialects": true,
    "frameworks": ["http-server", "next", "nuxt", "tanstack-start", "react"],
    "integrations": {
      "seo": {
        "base": "integrations/seo/apps/fullstack-web"
      }
    }
  }
}
