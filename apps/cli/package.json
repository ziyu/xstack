{
  "name": "xstack",
  "version": "3.47.0",
  "description": "Compose production-ready product templates from feature modules (auth, payments, i18n…) on top of a type-safe TypeScript stack",
  "keywords": [
    "better-auth",
    "xstack",
    "biome",
    "boilerplate",
    "cli",
    "drizzle",
    "elysia",
    "expo",
    "fullstack",
    "hono",
    "modules",
    "monorepo",
    "prisma",
    "product-template",
    "pwa",
    "react",
    "react-native",
    "saas",
    "shadcn",
    "starter",
    "tailwind",
    "tanstack",
    "tauri",
    "template",
    "trpc",
    "turborepo",
    "type-safety",
    "typescript"
  ],
  "homepage": "https://github.com/ziyu/xstack",
  "license": "MIT",
  "author": "Aman Varshney",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyu/xstack.git",
    "directory": "apps/cli"
  },
  "bin": {
    "xstack": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./cli": {
      "import": "./dist/cli.mjs"
    },
    "./virtual": {
      "types": "./dist/virtual.d.mts",
      "import": "./dist/virtual.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown --publint",
    "dev": "tsdown --watch",
    "check-types": "tsc --noEmit",
    "check-test-types": "tsc --noEmit -p tsconfig.tests.json",
    "test": "bun test ./test",
    "test:ci": "bun run build && XSTACK_SKIP_EXTERNAL_COMMANDS=1 XSTACK_TEST_MODE=1 bun run test --bail=5",
    "test:complete": "cd ../.. && bun run build && cd apps/cli && XSTACK_BUILD_SAMPLES=1 bun run test --bail=5",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@xstack/template-generator": "workspace:*",
    "@xstack/types": "workspace:*",
    "@clack/core": "^1.5.0",
    "@clack/prompts": "^1.8.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@orpc/server": "^1.15.6",
    "better-result": "^3.0.1",
    "consola": "^3.4.2",
    "env-paths": "^4.0.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.0",
    "gradient-string": "^3.0.0",
    "handlebars": "^4.7.9",
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.72.0",
    "picocolors": "^1.1.1",
    "semver": "^7.8.5",
    "tinyglobby": "^0.2.17",
    "trpc-cli": "^0.16.0",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.63.0",
    "@types/bun": "^1.4.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.5.0",
    "@types/semver": "^7.8.0",
    "publint": "^0.3.24",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
